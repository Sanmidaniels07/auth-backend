generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductCondition {
  NEW
  USED
  REFURBISHED
  FRESHLY_MADE
  MADE_TO_ORDER
  PRE_ORDER
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  OUT_OF_STOCK
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

// DELIVERY: the seller delivers to the buyer's area for a fee.
// PICKUP: the buyer collects from the seller - always free.
enum ShippingOptionType {
  DELIVERY
  PICKUP
}

// How a delivered item's receipt was confirmed: the seller entered the
// buyer's delivery code at handover, the buyer confirmed in-app, or it
// auto-confirmed after the buyer didn't respond.
enum DeliveryConfirmation {
  CODE
  BUYER
  AUTO
}

enum OrderEventType {
  PLACED
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CONFIRMED
  CANCELLED
  PROBLEM_REPORTED
}

enum OrderEventActor {
  BUYER
  SELLER
  SYSTEM
}

enum MediaType {
  IMAGE
  VIDEO
}

enum CommunityRole {
  MEMBER
  ADMIN
}

enum EventRsvpStatus {
  GOING
  INTERESTED
}

enum ReportTargetType {
  POST
  USER
  PRODUCT
  STORE
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  ACTION_TAKEN
}

enum ReturnRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  REFUNDED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
  MESSAGE
  ORDER
  SYSTEM
}

model User {
  id String @id @default(cuid())

  name     String
  email    String @unique
  password String

  username String? @unique
  avatar   String?
  cover    String?
  bio      String?
  location String?
  website  String?

  socialLinks Json?

  occupation  String?
  company     String?
  education   String?
  dateOfBirth DateTime?

  skills    String[] @default([])
  interests String[] @default([])
  languages String[] @default([])

  role Role @default(USER)

  isVerified Boolean @default(false)

  status       UserStatus @default(ACTIVE)
  statusReason String?

  deletedAt DateTime?

  twoFactorSecret  String?
  twoFactorEnabled Boolean @default(false)

  verificationToken       String?
  verificationTokenExpiry DateTime?

  resetToken       String?
  resetTokenExpiry DateTime?

  posts         Post[]
  comments      Comment[]
  likes         Like[]
  sessions      Session[]
  notifications Notification[]

  // Marketplace
  sellerProfile SellerProfile?

  wishlist Wishlist[]

  recentlyViewed RecentlyViewed[]

  cart Cart?

  orders Order[]

  addresses Address[]

  reviews Review[]

  productRevisions ProductRevision[]

  // Social
  following Follow[] @relation("Follower")
  followers Follow[] @relation("Following")

  createdCommunities   Community[]       @relation("CommunityCreator")
  communityMemberships CommunityMember[]

  createdEvents    Event[]         @relation("EventCreator")
  eventAttendances EventAttendee[]

  profileViewsReceived ProfileView[] @relation("ProfileOwner")
  profileViewsMade     ProfileView[] @relation("Viewer")

  storeFollows StoreFollow[]

  reports           Report[]
  returnRequests    ReturnRequest[]
  couponRedemptions CouponRedemption[]

  conversationParticipations ConversationParticipant[]
  sentMessages               Message[]

  stories        Story[]
  storyViews     StoryView[]
  storyReactions StoryReaction[]

  blockedUsers   Block[] @relation("Blocker")
  blockedByUsers Block[] @relation("Blocked")

  notificationPreferences NotificationPreference[]
  pushTokens              PushToken[]

  savedCards SavedCard[]

  eventComments EventComment[]

  storeViews StoreView[]

  createdAt DateTime @default(now())
}

model Block {
  id String @id @default(cuid())

  blockerId String
  blocker   User   @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)

  blockedId String
  blocked   User   @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model NotificationPreference {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type NotificationType

  enabled Boolean @default(true)

  @@unique([userId, type])
}

model PushToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token String @unique

  platform String?

  createdAt DateTime @default(now())
}

model SavedCard {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  authorizationCode String @unique

  last4 String?

  expMonth String?

  expYear String?

  bank String?

  cardType String?

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
}

model Story {
  id String @id @default(cuid())

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  mediaUrl String

  mediaType MediaType

  caption String?

  createdAt DateTime @default(now())

  expiresAt DateTime

  views StoryView[]

  reactions StoryReaction[]
}

model StoryView {
  id String @id @default(cuid())

  storyId String
  story   Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)

  viewerId String
  viewer   User   @relation(fields: [viewerId], references: [id])

  viewedAt DateTime @default(now())

  @@unique([storyId, viewerId])
}

model StoryReaction {
  id String @id @default(cuid())

  storyId String
  story   Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  emoji String

  createdAt DateTime @default(now())

  @@unique([storyId, userId])
}

model StoreFollow {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, storeId])
}

model Report {
  id String @id @default(cuid())

  reporterId String
  reporter   User   @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  targetType ReportTargetType
  targetId   String

  reason String

  status ReportStatus @default(PENDING)

  reviewedBy String?
  reviewedAt DateTime?

  createdAt DateTime @default(now())
}

model ReturnRequest {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  orderItemId String?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  reason String

  status ReturnRequestStatus @default(REQUESTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Coupon {
  id String @id @default(cuid())

  code String @unique

  type CouponType

  value Float

  minOrderAmount Float?

  usageLimit Int?

  usedCount Int @default(0)

  expiresAt DateTime?

  isActive Boolean @default(true)

  redemptions CouponRedemption[]

  createdAt DateTime @default(now())
}

model CouponRedemption {
  id String @id @default(cuid())

  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())

  @@unique([couponId, userId])
}

model Conversation {
  id String @id @default(cuid())

  participants ConversationParticipant[]
  messages     Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ConversationParticipant {
  id String @id @default(cuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([conversationId, userId])
}

model Message {
  id String @id @default(cuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  // Optional now that a message can be media-only (a picture/video with no
  // caption) - see MessageMedia below, mirrors Post/PostMedia.
  content String?

  media MessageMedia[]

  readAt DateTime?

  createdAt DateTime @default(now())
}

model MessageMedia {
  id String @id @default(cuid())

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  url String

  type MediaType

  order Int @default(0)
}

model Follow {
  id String @id @default(cuid())

  followerId String
  follower   User   @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)

  followingId String
  following   User   @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
}

model ProfileView {
  id String @id @default(cuid())

  profileUserId String
  profileUser   User   @relation("ProfileOwner", fields: [profileUserId], references: [id], onDelete: Cascade)

  viewerId String?
  viewer   User?   @relation("Viewer", fields: [viewerId], references: [id], onDelete: SetNull)

  viewedAt DateTime @default(now())
}

model Community {
  id String @id @default(cuid())

  name String

  slug String @unique

  description String?

  icon String?

  creatorId String
  creator   User   @relation("CommunityCreator", fields: [creatorId], references: [id])

  members CommunityMember[]

  createdAt DateTime @default(now())
}

model CommunityMember {
  id String @id @default(cuid())

  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role CommunityRole @default(MEMBER)

  joinedAt DateTime @default(now())

  @@unique([communityId, userId])
}

model Event {
  id String @id @default(cuid())

  title String

  description String?

  coverImage String?

  location String?

  startAt DateTime

  endAt DateTime?

  creatorId String
  creator   User   @relation("EventCreator", fields: [creatorId], references: [id])

  attendees EventAttendee[]

  comments EventComment[]

  createdAt DateTime @default(now())
}

model EventComment {
  id String @id @default(cuid())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  content String

  createdAt DateTime @default(now())
}

model EventAttendee {
  id String @id @default(cuid())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status EventRsvpStatus @default(GOING)

  createdAt DateTime @default(now())

  @@unique([eventId, userId])
}

model Post {
  id String @id @default(cuid())

  title   String?
  content String?

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  isDeleted Boolean @default(false)

  comments Comment[]

  likes Like[]

  media PostMedia[]

  hashtags PostHashtag[]

  // Optional product the author tagged ("shop this post"). Only the
  // author's own published products can be tagged; if the product is
  // deleted the tag just disappears.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([productId])
}

model PostMedia {
  id String @id @default(cuid())

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  url String

  type MediaType

  order Int @default(0)
}

model Hashtag {
  id String @id @default(cuid())

  tag String @unique

  posts PostHashtag[]

  createdAt DateTime @default(now())
}

model PostHashtag {
  id String @id @default(cuid())

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  hashtagId String
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, hashtagId])
}

model Comment {
  id String @id @default(cuid())

  content String

  userId String
  user   User   @relation(fields: [userId], references: [id])

  postId String
  post   Post   @relation(fields: [postId], references: [id])

  createdAt DateTime @default(now())
}

model Like {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  postId String
  post   Post   @relation(fields: [postId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model Session {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  refreshToken String @unique

  expiresAt DateTime

  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())
}

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  type NotificationType @default(SYSTEM)

  title   String
  message String

  // What the notification is about, so the client can deep-link to it
  // (e.g. targetType "POST" + targetId -> that post). Null for
  // notifications with no single destination (e.g. account status change).
  targetType String?
  targetId   String?

  isRead Boolean @default(false)

  createdAt DateTime @default(now())
}

model SellerProfile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  status          SellerStatus @default(PENDING)
  statusReason    String?
  statusUpdatedAt DateTime?

  cacNumber String?

  isVerified Boolean @default(false)

  createdAt DateTime @default(now())

  store Store?
}

model Store {
  id String @id @default(cuid())

  sellerId String        @unique
  seller   SellerProfile @relation(fields: [sellerId], references: [id])

  name String

  slug String @unique

  description String?

  logo String?

  banner String?

  email String?

  phone String?

  address String?

  city String?

  state String?

  country String?

  rating Float @default(0)

  totalSales Int @default(0)

  isVerified Boolean @default(false)

  isSuspended Boolean @default(false)

  returnPolicy   String?
  shippingPolicy String?
  warrantyPolicy String?

  // Bank details the seller registers for payouts. Once resolved and a
  // Paystack subaccount is created (payoutBankCode + paystackSubaccountCode
  // both set), new orders route this store's share straight to them via a
  // Paystack dynamic split at checkout. Until then (or if subaccount
  // creation fails), revenue accrues in the manual Payout ledger instead -
  // see Payout model.
  payoutBankName         String?
  payoutBankCode         String?
  payoutAccountNumber    String?
  payoutAccountName      String?
  paystackSubaccountCode String?

  // Set every time payout bank details change. Checkout won't route this
  // store's split to a *newly* changed subaccount until PAYOUT_ACCOUNT_HOLD_HOURS
  // has passed since this timestamp - revenue accrues in the manual Payout
  // ledger during the hold instead, giving admin/the seller a window to
  // catch and reverse a fraudulent change before real money moves.
  payoutAccountUpdatedAt DateTime?

  payoutAccountChanges PayoutAccountChange[]

  products Product[]

  reviews Review[]

  followers StoreFollow[]

  shippingOptions ShippingOption[]

  orderShipments OrderShipping[]
  orderNotes     OrderSellerNote[]

  payouts Payout[]

  storeViews StoreView[]

  createdAt DateTime @default(now())
}

model Payout {
  id String @id @default(cuid())

  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  amount Float

  note String?

  createdBy String

  createdAt DateTime @default(now())
}

// Audit trail for payout bank-account changes - admin's window into a
// fraud vector that used to be completely silent (a seller, or an
// attacker who compromised one, could redirect payouts with nobody
// noticing until money was gone).
model PayoutAccountChange {
  id String @id @default(cuid())

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  previousBankName      String?
  previousAccountNumber String?

  newBankName      String
  newAccountNumber String

  changedAt DateTime @default(now())
}

model StoreView {
  id String @id @default(cuid())

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  viewerId String?
  viewer   User?   @relation(fields: [viewerId], references: [id], onDelete: SetNull)

  viewedAt DateTime @default(now())
}

// A delivery zone: the price to deliver to a group of areas (e.g.
// "Amuwo Odofin / Festac / Ago" for N2,500). A zone with no areas applies to
// any buyer (e.g. "Pickup" or a flat nationwide rate). Orders keep their own
// snapshot (OrderShipping), so editing, archiving or deleting is safe.
model ShippingOption {
  id String @id @default(cuid())

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name String

  fee Float

  eta String?

  type ShippingOptionType @default(DELIVERY)

  // Areas this zone covers (neighbourhoods / LGAs) and the state they're in.
  // Always empty for pickup.
  areas String[] @default([])
  state String?

  // Pickup only: where buyers collect. Falls back to the store's address.
  pickupAddress String?

  // Archived zones are hidden from buyers but kept for the seller to restore.
  isArchived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Category {
  id String @id @default(cuid())

  name String

  slug String @unique

  icon String?

  isFeatured Boolean @default(false)

  // Platform commission for products in this category, as a percentage
  // (10 = 10%). Varies by category, Jumia-style - electronics lower,
  // fashion/beauty higher. Applied at checkout time (snapshotted onto
  // OrderItem.commissionRate) so later changes here don't retroactively
  // change already-placed orders.
  commissionRate Float @default(10)

  products Product[]

  createdAt DateTime @default(now())
}

model Product {
  id String @id @default(cuid())

  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  title String

  slug String @unique

  description String

  sku String @unique

  brand String?

  condition ProductCondition @default(NEW)

  status ProductStatus @default(DRAFT)

  isFeatured Boolean @default(false)

  highlights String[] @default([])

  price Float

  originalPrice Float?

  stock Int

  images ProductImage[]

  specifications ProductSpecification[]

  // Old free-form name/value rows from before options existed. Never shown
  // to buyers; kept so no seller data is lost.
  legacyVariants LegacyProductVariant[]

  // Up to two options (e.g. Size, Colour) and one variation per
  // combination. Products without options have neither.
  options    ProductOption[]
  variations ProductVariation[]

  wishlist Wishlist[]

  recentlyViewed RecentlyViewed[]

  reviews Review[]

  // Set when the seller turns the listing into something different (new
  // category or a mostly different title). Reviews written before it are
  // labelled as for an earlier version and left out of the rating.
  reviewsResetAt DateTime?

  // Admin-only log of the seller's edits.
  revisions ProductRevision[]

  orderItems OrderItem[]

  taggedInPosts Post[]

  createdAt DateTime @default(now())

  updatedAt DateTime   @updatedAt
  cartItems CartItem[]
}

model ProductImage {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  url String

  isPrimary Boolean @default(false)
}

model ProductSpecification {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  name String

  value String
}

// One saved edit to a product: what changed, who did it and when. Shown to
// admins for disputes and spotting sellers who switch listings around.
// Stock changes from orders aren't recorded - only edits.
model ProductRevision {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  editedById String?
  editedBy   User?   @relation(fields: [editedById], references: [id], onDelete: SetNull)

  // [{ field, from, to }] - readable values ("₦2,000", "Size: S, M").
  changes Json

  // This edit marked earlier reviews as for an earlier version.
  reviewsReset Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

model LegacyProductVariant {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  name String

  value String

  price Float?

  stock Int @default(0)

  @@map("ProductVariant")
}

// A choice buyers make on a product, e.g. Size: [Small, Medium, Large].
model ProductOption {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name String

  // In the order buyers see them.
  values String[]

  // 0 or 1 - which option this is (option1/option2 on a variation).
  position Int

  @@unique([productId, position])
}

// One sellable combination of a product's options (e.g. Large / Vanilla),
// with its own stock and optionally its own price. The product's stock is
// kept as the total of its active variations.
model ProductVariation {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  option1 String
  // "" when the product has a single option.
  option2 String @default("")

  // Null uses the product's price.
  price Float?

  stock Int @default(0)

  // Seller switched this combination off (not sold).
  isActive Boolean @default(true)

  // Removed by the seller but kept because orders point at it. Hidden
  // from buyers.
  isArchived Boolean @default(false)

  cartItems  CartItem[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, option1, option2])
}

model Wishlist {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model RecentlyViewed {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  viewedAt DateTime @default(now())

  @@unique([userId, productId])
}

model Cart {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id String @id @default(cuid())

  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  // Set when the product has options - which combination the buyer chose.
  variationId String?
  variation   ProductVariation? @relation(fields: [variationId], references: [id], onDelete: Cascade)

  quantity Int @default(1)

  createdAt DateTime @default(now())

  @@index([cartId, productId])
}

model Address {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName String

  phone String

  address String

  city String

  state String

  country String

  postalCode String?

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  orders    Order[]
}

model Order {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  addressId String
  address   Address @relation(fields: [addressId], references: [id])

  status OrderStatus @default(PENDING)

  subtotal Float

  deliveryFee Float

  tax Float

  discountAmount Float @default(0)

  couponCode String?

  total Float

  paymentMethod String?

  paymentReference String? @unique

  trackingNumber String?

  items OrderItem[]

  shipping OrderShipping[]

  sellerNotes OrderSellerNote[]

  returnRequests ReturnRequest[]

  couponRedemption CouponRedemption?

  events OrderEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderShipping {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  optionName String

  fee Float

  eta String?

  // Snapshot of how this store's items reach the buyer, and for pickup,
  // where to collect them.
  type          ShippingOptionType @default(DELIVERY)
  pickupAddress String?

  // 6-digit code only the buyer can see. The seller enters it at handover
  // to mark this store's items delivered (and confirmed) in one step. Never
  // include it in seller-facing queries. Null on orders placed before
  // delivery codes existed.
  deliveryCode         String?
  // Wrong code entries - locked after a few so it can't be guessed; the
  // seller then falls back to marking delivered for the buyer to confirm.
  deliveryCodeAttempts Int     @default(0)

  // True when this fee went straight to the seller's subaccount in the
  // Paystack split. False means the platform received it and still owes it
  // to the seller via the manual Payout ledger (see sellerRevenue.ts) -
  // including every order placed before delivery fees were split.
  paidViaSplit Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([orderId, storeId])
}

// Optional note the buyer leaves one seller at checkout (extras, sizes,
// a message for a gift). One per store per order, so in a multi-seller
// order each seller only sees what was meant for them.
model OrderSellerNote {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  note String

  createdAt DateTime @default(now())

  @@unique([orderId, storeId])
  @@index([storeId])
}

// Append-only history of what happened to an order and when - powers the
// buyer's timeline with real dates.
model OrderEvent {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  orderItemId String?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  type  OrderEventType
  actor OrderEventActor
  note  String?

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity Int

  unitPrice Float

  totalPrice Float

  // Snapshot of the product's category commission rate (%) at the time
  // this order was placed. Existing rows default to 0 so past orders
  // aren't retroactively charged a commission that didn't exist yet.
  commissionRate Float @default(0)

  // True if this item's net revenue was routed straight to the seller's
  // Paystack subaccount via a dynamic split at checkout (their store had
  // one configured at the time). False means the money is sitting in the
  // platform's main account and still needs a manual Payout record.
  autoPaidViaSplit Boolean @default(false)

  // Copy of the listing as the buyer saw it when ordering. Order pages,
  // emails and disputes use this, so editing the product later never
  // changes what was bought. Orders placed before snapshots existed were
  // filled in from the product as it was on 23 Oct 2026.
  productTitle       String?
  productImage       String?
  productDescription String?
  productBrand       String?
  productCondition   ProductCondition?
  productSku         String?
  productHighlights  String[]          @default([])
  // The buyer's choice, e.g. "Size: Large · Flavour: Vanilla".
  variantLabel       String?
  variationId        String?
  variation          ProductVariation? @relation(fields: [variationId], references: [id], onDelete: SetNull)
  // [{ name, value }]
  productSpecs       Json?

  status OrderItemStatus @default(PENDING)

  shippedAt           DateTime?
  deliveredAt         DateTime?
  // Set once receipt is confirmed (see DeliveryConfirmation). Starts the
  // return window. Delivered-but-unconfirmed items auto-confirm after a few days.
  deliveryConfirmedAt DateTime?
  deliveryConfirmedBy DeliveryConfirmation?

  events OrderEvent[]

  returnRequests ReturnRequest[]
}

model Review {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  rating Int

  comment String?

  reply     String?
  repliedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([userId, productId])
}
