# Copy to .env for local development. Production and staging set these in
# their Render service's Environment tab - see DEPLOYMENT.md.

# --- Environment ---------------------------------------------------------
# Unset in production. "staging" on the staging service. "development" locally
# (only needed to run `npm run seed` against a local database).
APP_ENV=development
PORT=5000

# --- Database (Supabase) ---------------------------------------------------
DATABASE_URL=
DIRECT_URL=

# --- Auth -------------------------------------------------------------------
# Must be different in every environment.
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- URLs -------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
# Extra allowed browser origins, comma-separated (optional).
CORS_ORIGINS=
# Public URL of this API, shown in Swagger on staging (optional).
PUBLIC_API_URL=

# --- Email (Resend) -----------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_USER=
EMAIL_PASS=

# --- Images (Cloudinary) ------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payments (Paystack) ------------------------------------------------------
# sk_live_... in production ONLY. sk_test_... everywhere else.
PAYSTACK_SECRET_KEY=

# --- Orders ------------------------------------------------------------------
# Days before a delivered item auto-confirms (default 5). Staging can use e.g. 0.01.
AUTO_CONFIRM_DAYS=

# Seller payouts (see src/utils/payoutMode.ts). Both off by default.
# PAYOUTS_HOLD=true       hold-then-pay: no split at checkout; Nestly pays each seller after the return window closes
# PAYSTACK_TRANSFERS=true send those payouts automatically by Paystack Transfer (needs Transfers enabled, transfer OTP off, funds in the balance)
PAYOUTS_HOLD=false
PAYSTACK_TRANSFERS=false

# Live selling video - LiveKit Cloud project (cloud.livekit.io -> Settings -> Keys).
# Without these, sellers can still schedule lives but can't go live.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# How long a live can run before it ends by itself (minutes, 5-120). Default 10.
LIVE_MAX_MINUTES=10

# Automatic CAC checks - Dojah (dojah.io -> Developers -> Configuration).
# App ID + SECRET key (not the public key). Sandbox: https://sandbox.dojah.io
# (made-up data, test numbers 1261103 / 14320749). Live: https://api.dojah.io
# (charged per lookup). Without keys, admins check CAC numbers by hand.
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
DOJAH_BASE_URL=https://sandbox.dojah.io
